before_all do |lane|
  File.write("#{FASTLANE_SPEC_SCRATCH}/before_all_#{lane}", '1') if lane
end

lane :test do 
  File.write("#{FASTLANE_SPEC_SCRATCH}/test", '1')
end

lane :deploy do
  File.write("#{FASTLANE_SPEC_SCRATCH}/deploy", '1')
end

after_all do |lane|
  File.write("#{FASTLANE_SPEC_SCRATCH}/after_all", lane)
end

lane :error_causing_lane do
  1/0
end

error do |lane, exception|
  File.write("#{FASTLANE_SPEC_SCRATCH}/error", lane)
end